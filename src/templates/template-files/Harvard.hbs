<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="./css/example.css">
    <style>
        {{{css}}}
        body {
            font-family: 'Times New Roman', serif;
        }

        a {
            color: black;
        }

        h1 {
            font-size: 24px;
            font-weight: bold;
            text-transform: uppercase;
        }
        p,li{
            font-size: 11px;
            text-align: left;
        }

        .headerCV{
            margin: 40px 0;
            display: flex;
            flex-direction: column;

            h1 {
                font-size: 35px;
            }
        }

        .contact__info {
            font-weight: lighter;
            font-size: 16px;
        }

        @page{
            size: A4;
            margin: 10mm;
        }


        .subtitle {
            font-weight: bold;
            width: 100%;
            text-transform: uppercase;
        }

        .subtitle.subtitle-1 {
            font-size: 16px;
        }

        .subtitle.subtitle-2 {
            font-size: 12px;
        }

        .subtitle.underlined::after {
            height: 1px;
            width: 100%;
            display: block;
            margin-top: 4px;
            content: "";
            background-color: gray;
        }

        .resume {
            line-height: 1.4;
        }

        .subtitleInner h2{
            font-size: 12px;
            font-weight: bold;
        }

        .date {
            font-size: 10px;
            font-weight: lighter;
        }

        .workExperience {
            margin: 8px 0;
        }

        .titleWithDateInfo {
            display: flex;
            justify-content: space-between;
        }

        .titleWithDateInfo .subtitle {
            text-align: left;
            font-weight: bold;
        }

        .mainElement{
            margin: 15px 0;
        }

        .grid {
            display: grid;
        }

        .grid-cols-3 {
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        .grid-cols-4 {
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .sectionSpacing {
            margin: 25px 0;
        }
    </style>
</head>

<body>
    <div class="headerCV">
        <h1 class="text-center margin-0 padding-0">{{data.fullname}}</h1>
        <h3 class="text-center margin-0 padding-0 contact__info">{{data.email}} - {{data.phoneNumber}} - {{data.residence}}</h3>
    </div>
    <section class="sectionSpacing">
        <h2 class="subtitle subtitle-1 underlined">{{data.t.summary}}</h2>
        <p class="resume">{{data.resume}}</p>
    </section>

    <section class="sectionSpacing">
        <h2 class="subtitle subtitle-1 underlined">{{data.t.workExperience}}</h2>
        {{#each data.workExperience}}
            <div class="mainElement">
                <div class="titleWithDateInfo">
                    <div>
                        <h2 class="subtitle subtitle-2 margin-0">{{companyName}}</h2>
                        <p class="margin-0">{{occupation}}</p>
                    </div>
                    <div>
                        <h3 class="date">{{rangeDate}}</h3>
                    </div>
                </div>
                <article>
                    {{#if achievements}}
                        <ul>
                            {{#each achievements}}
                            <li>{{this}}</li>
                            {{/each}}
                        </ul>
                    {{/if}}
                </article>
            </div>
        {{/each}}
    </section>

    <section class="sectionSpacing">
        <h2 class="subtitle subtitle-1 underlined">{{data.t.education}}</h2>
        {{#each data.education}}
        <div class="mainElement">
            <div class="titleWithDateInfo">
                <div>
                    <h2 class="subtitle subtitle-2 margin-0 padding-0">{{institutionName}}</h2>
                    <p class="margin-0 padding-0">{{titleName}}</p>
                    <p class="margin-0 padding-0">{{type}}</p>
                </div>
                <p>{{graduationDate}}</p>
            </div>
        </div>
        {{/each}}
    </section>

    {{#if data.certifications}}
        <section class="sectionSpacing">
        <h2 class="subtitle subtitle-1 underlined">{{data.t.certifications}}</h2>
            {{#each data.certifications}}
                <div class="mainElement">
                    <div class="titleWithDateInfo">
                        <div>
                            <h2 class="subtitle subtitle-2 margin-0 padding-0">{{name}}</h2>
                            <p class="margin-0 padding-0">{{institution}}</p>
                        </div>
                        <p>{{year}}</p>
                    </div>
                </div>
            {{/each}}
        </section>
    {{/if}}
    
    {{#if data.projects}}
        <section class="sectionSpacing">
            <h2 class="subtitle subtitle-1 underlined">{{data.t.projects}}</h2>
            <div class="">
                {{#each data.projects}}
                    <div class="mainElement">
                        <h2 class="subtitle subtitle-2 margin-0 padding-0">{{title}}</h2>
                        <p style="text-align: justify;" class="margin-0 padding-0">{{description}}</p>
                    </div>
                {{/each}}
            </div>
        </section>
    {{/if}}

    {{#if data.languages}}
        <h2 class="subtitle subtitle-1 underlined">{{data.t.languages}}</h2>
        <ul class="grid grid-cols-4">
            {{#each data.languages}}
                <li>
                    {{name}} - {{level}}
                </li>
            {{/each}}
        </ul>
    {{/if}}

    {{#if data.skills}}
        <section class="sectionSpacing">
            <h2 class="subtitle subtitle-1 underlined">{{data.t.skills}}</h2>
                <div class="grid grid-cols-4">
                    {{#each data.skills}}
                        <p>{{name}}</p>
                    {{/each}}
                </div>
            </div>
        </section>
    {{/if}}
</body>

</html>