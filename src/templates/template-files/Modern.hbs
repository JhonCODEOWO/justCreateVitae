<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="./css/example.css">
    <style>
        {{{css}}}

        :root {
            --mainContent: white;
            --mainColor: #d5e5ff;
            --secondColor: #9dc1fd;
            --asideFontColor: #2b2b2b
        }

        main > section {
            padding: 20px;
        }

        body {
            font-family: HK GROTESK;
        }

        a {
            color: black;
        }

        ul {
            padding: 0;
        }

        h1 {
            font-size: 40px;
            font-weight: bold;
            text-transform: uppercase;
            line-height: 1.2;
            letter-spacing: 1px;
        }

        

        .headerCV{
            padding: 0 15px;
        }

        .contact__info {
            font-size: 16px;
        }


        .subtitle {
            text-align: center;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .resume {
            line-height: 1.4;
        }

        .subtitleInner h2{
            font-size: 12px;
            font-weight: bold;
        }

        .date {
            font-size: 10px;
            font-weight: lighter;
        }

        .workExperience {
            margin-bottom: 8px;
        }
        .titleWithDateInfo {
            display: flex;
            justify-content: space-between;
        }

        .titleWithDateInfo .subtitle {
            font-size: 12px;
            text-align: left;
            font-weight: bold;
        }

        .mainElement{
            margin-bottom: 8px;
        }

        .grid {
            display: grid;
        }

        .grid-cols-4 {
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .sectionSpacing {
            margin: 40px 0 0 0;
        }

        .aside {
            background-color: var(--mainColor);
            min-height: 100dvh;
            color: var(--asideFontColor);
        }

        aside > section {
            padding: 0 20px;
        }

        .title {
            padding: 10px;
        }

        .title__Aside {
            background-color: var(--secondColor);
        }

        .title__Main {
            background-color: var(--mainContent);
        }

        .profesionalResume{
            background-color: var(--secondColor);
        }

        .skill {
            align-items: center;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            justify-content: space-between;
            column-gap: 20px;
        }

        .educationElement {
            display: flex;
            column-gap: 15px;

            .educationElement__date {
                font-weight: normal;
            }

            .educationElement__institutionName {
                font-weight: bolder;
                font-size: medium;
            }
        }

        .workElement {
            .workElement__date{
                
            }

            .workElement__info{
                
            }

            .workElement__achievements{
                padding-left: 30px;
            }
        }

        .languageElement {
            display: flex;
            justify-content: space-between;
        }

        .progress {
            width: 100%;
            height: 10px;
            border-radius: 10px;
            background-color: var(--mainContent);
            overflow: hidden;
        }

        .progress__value {
            height: 100%;
            background-color: var(--secondColor);
        }

        .contactElement {
            display: flex;
            align-items: center;
            column-gap: 10px;

            .contactElement__icon {
                width: 20px;
                height: 20px;
            }
        }
    </style>
</head>

<body>
    <div class="flex">
        <aside class="aside">
            <div class="headerCV">
                <h1>{{data.fullname}}</h1>
            </div>
            <h2 class="title title__Aside">Contacto</h2>
            <section>
                <div class="contactElement">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="contactElement__icon">
                        <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
                        <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
                    </svg>
                    <a href="mailto:{{data.email}}">{{data.email}}</a>
                </div>
                <div class="contactElement">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="contactElement__icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                    </svg>
                    <p>{{data.phoneNumber}}</p>
                </div>
                <div class="contactElement">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="contactElement__icon">
                    <path d="M21.721 12.752a9.711 9.711 0 0 0-.945-5.003 12.754 12.754 0 0 1-4.339 2.708 18.991 18.991 0 0 1-.214 4.772 17.165 17.165 0 0 0 5.498-2.477ZM14.634 15.55a17.324 17.324 0 0 0 .332-4.647c-.952.227-1.945.347-2.966.347-1.021 0-2.014-.12-2.966-.347a17.515 17.515 0 0 0 .332 4.647 17.385 17.385 0 0 0 5.268 0ZM9.772 17.119a18.963 18.963 0 0 0 4.456 0A17.182 17.182 0 0 1 12 21.724a17.18 17.18 0 0 1-2.228-4.605ZM7.777 15.23a18.87 18.87 0 0 1-.214-4.774 12.753 12.753 0 0 1-4.34-2.708 9.711 9.711 0 0 0-.944 5.004 17.165 17.165 0 0 0 5.498 2.477ZM21.356 14.752a9.765 9.765 0 0 1-7.478 6.817 18.64 18.64 0 0 0 1.988-4.718 18.627 18.627 0 0 0 5.49-2.098ZM2.644 14.752c1.682.971 3.53 1.688 5.49 2.099a18.64 18.64 0 0 0 1.988 4.718 9.765 9.765 0 0 1-7.478-6.816ZM13.878 2.43a9.755 9.755 0 0 1 6.116 3.986 11.267 11.267 0 0 1-3.746 2.504 18.63 18.63 0 0 0-2.37-6.49ZM12 2.276a17.152 17.152 0 0 1 2.805 7.121c-.897.23-1.837.353-2.805.353-.968 0-1.908-.122-2.805-.353A17.151 17.151 0 0 1 12 2.276ZM10.122 2.43a18.629 18.629 0 0 0-2.37 6.49 11.266 11.266 0 0 1-3.746-2.504 9.754 9.754 0 0 1 6.116-3.985Z" />
                    </svg>
                    <a href={{data.mainSite}}>{{data.mainSite}}</a>
                </div>
                <div class="contactElement">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="contactElement__icon">
                    <path fill-rule="evenodd" d="m11.54 22.351.07.04.028.016a.76.76 0 0 0 .723 0l.028-.015.071-.041a16.975 16.975 0 0 0 1.144-.742 19.58 19.58 0 0 0 2.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 0 0-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 0 0 2.682 2.282 16.975 16.975 0 0 0 1.145.742ZM12 13.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd" />
                    </svg>
                    <p>{{data.residence}}, {{data.country}}</p>
                </div>
            </section>
            <h2 class="title title__Aside">Habilidades</h2>
            <section>
                <ul>
                    {{#each data.skills}}
                        <div class="skill">
                            <p>{{name}}</p>
                            <div class="progress">
                                <div style="width: {{level}}%;" class="progress__value"></div>
                            </div>
                        </div>
                    {{/each}}
                </ul>
            </section>
            <h2 class="title title__Aside">Idiomas</h2>
            <section>
                <ul>
                    {{#each data.languages}}
                        <div class="languageElement">
                            <p>{{name}}</p>
                            <p>{{level}}</p>
                        </div>
                    {{/each}}
                </ul>
            </section>
        </aside>
        <main>
            <section class="profesionalResume">
                <h2>Perfil Profesional</h2>
                <p class="resume">{{data.resume}}</p>
            </section>
            <section>
                <h2 class="title__Main">Estudios</h2>
                {{#each data.education}}
                    <div class="educationElement">
                        <p class="educationElement__date">{{graduationDate}}</p>
                        <p class="educationElement__institutionName">{{institutionName}}</p>
                    </div>
                {{/each}}
            </section>
            <section>
                <h2 class="title__Main">Experiencia laboral</h2>
                {{#each data.workExperience}}
                    <div class="workElement">
                        <div class="flex gap-column-sm">
                            <p class="workElement__date">{{startDate}}</p>
                            <p class="workElement__companyName bold">{{companyName}}</p>
                        </div>
                        <ul class="workElement__achievements">
                            {{#each achievements}}
                                <li>{{this}}</li>
                            {{/each}}
                        </ul>
                    </div>
                {{/each}}
            </section>
        </main>
    </div>
</body>
</html>